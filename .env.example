# Copy to .env and adjust. Every value is optional.

PORT=3000
# Shown on certificates and pre-filled on the sign-up form.
COLLEGE_NAME="SRM Easwari Engineering College"
# The college logo lives in public/: college-logo.png (white text, for the dark app screens)
# and college-seal-print.png (for certificates and OD letters). Replace those files to rebrand.
# Public URL of the app, used for links inside emails.
APP_URL=http://localhost:3000
# Secret used to sign check-in QR codes. Change this before going live.
QR_SECRET=change-me-to-a-long-random-string

# Show the one-click demo accounts on the sign-in page. Set to false before real use.
SHOW_DEMO_ACCOUNTS=true

# Optional email delivery (approvals, reminders, certificates). Leave blank to keep in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CampusPulse <no-reply@yourcollege.edu>"
